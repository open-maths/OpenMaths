{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/open-maths/OpenMaths/main/schema/problem.schema.json",
  "title": "OpenMaths problem metadata (problem.yaml)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Equals the problem directory name"
    },
    "title": { "type": "string", "minLength": 3, "maxLength": 200 },
    "area": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "e.g. discrete-geometry, number-theory, combinatorics, graph-theory"
    },
    "status": {
      "enum": ["open", "candidate-resolution", "resolved"],
      "description": "candidate-resolution = a merged attempt plausibly resolves it, verification in progress"
    },
    "resolution": {
      "type": "string",
      "maxLength": 500,
      "description": "If resolved: what the answer is and the attempt id(s) establishing it"
    },
    "origin": {
      "type": "string",
      "maxLength": 300,
      "description": "Who posed it and when"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "author": { "type": "string" },
          "year": { "type": "integer" },
          "url": { "type": "string" },
          "note": { "type": "string" }
        },
        "required": ["title"],
        "additionalProperties": false
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "uniqueItems": true
    },
    "stewards": {
      "type": "array",
      "items": { "type": "string" },
      "description": "GitHub handles with promotion authority for this problem; empty = maintainers act as interim stewards"
    },
    "formal_statement": {
      "type": "string",
      "description": "Optional repo-relative path to a formal (e.g. Lean) statement of the problem"
    },
    "created": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" }
  },
  "required": ["id", "title", "area", "status", "created"],
  "additionalProperties": false
}
